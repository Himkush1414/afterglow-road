; Engine configuration file.
; Settings are edited by hand and kept in version control.

config_version=5

[application]

config/name="afterglow-road"
config/features=PackedStringArray("4.7")
run/main_scene="res://scenes/boot.tscn"
config/version="0.1.0"

[autoload]

Log="*res://src/core/log.gd"
Settings="*res://src/core/settings.gd"
ContentDB="*res://src/core/content_db.gd"
SaveGame="*res://src/core/save_game.gd"
Net="*res://src/core/net.gd"
InputRouter="*res://src/core/input_router.gd"
App="*res://src/core/app.gd"

[debug]

file_logging/enable_file_logging=true

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60
common/physics_interpolation=true
jolt_physics_3d/simulation/penetration_slop=0.005

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=false
textures/vram_compression/import_etc2_astc=true

[internationalization]

locale/translations=PackedStringArray("res://ui/i18n/ui.en.translation")

[shader_globals]

cloud_shadow_tex={
"type": "sampler2D",
"value": ""
}
cloud_shadow_drift={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow_wind={
"type": "vec2",
"value": Vector2(0, 0)
}
cloud_shadow_t0={
"type": "float",
"value": 0.0
}
cloud_shadow_cover={
"type": "float",
"value": 0.0
}
cloud_shadow_tile_m={
"type": "float",
"value": 2000.0
}
cloud_time_rollover_s={
"type": "float",
"value": 3600.0
}
